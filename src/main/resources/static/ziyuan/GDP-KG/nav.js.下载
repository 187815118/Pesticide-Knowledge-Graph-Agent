function isEmailAvailable(obj) {
    let email = /^([a-zA-Z0-9]+[_|\_|\.]?)*[a-zA-Z0-9]+@([a-zA-Z0-9]+[_|\_|\.]?)*[a-zA-Z0-9]+\.[a-zA-Z]{2,3}$/;
    if (!email.test(obj)) {
        return false;
    }
    return true;
}

function email_submit() {

    const data = new FormData();
    var email = document.getElementsByClassName("letter")[0].getElementsByTagName("input")[0].value
    if (isEmailAvailable(email)) {
        data.append("email", email);

        const xhr = new XMLHttpRequest();
        xhr.withCredentials = true;

        xhr.addEventListener("readystatechange", function () {
            if (this.readyState === this.DONE) {
                var flag = JSON.parse(this.responseText).flag
                if (flag) {
                    alert("Thank you for your support!")
                }
            }
        });

        xhr.open("POST", "http://localhost:1516/user/contactMe");

        xhr.send(data);
    } else {
        alert("Please check your email")
    }

}
