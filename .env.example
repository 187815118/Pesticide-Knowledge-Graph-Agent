# Copy to .env and fill in credentials locally. This file is NOT loaded automatically.
# For Bash: set -a; source .env; set +a
NEO4J_HTTP_URL=http://127.0.0.1:7474/db/data/transaction/commit
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MYSQL_PASSWORD=
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5-7b-instruct
AGENT_API_BASE_URL=http://127.0.0.1:8001
# vLLM model directory; replace before starting full inference.
QWEN_MODEL_PATH=/path/to/Qwen2.5-7B-Instruct-AWQ
